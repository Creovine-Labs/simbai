# Firebase web app config. These are public client values from Firebase Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase token verification. Can match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Created by the Vercel Blob integration. Only needed when VERCEL=1, which is
# what switches the store from `.data/` on disk to Blob.
BLOB_READ_WRITE_TOKEN=
